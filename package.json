{
  "name": "dsh-plugin-workspace-browser",
  "version": "0.1.15",
  "type": "module",
  "description": "An isolated workspace Chromium sidebar for DeepSeek Harness Web and Desktop.",
  "license": "MIT",
  "author": "hestudio-community",
  "homepage": "https://github.com/hestudio-community/dsh-plugin-workspace-browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hestudio-community/dsh-plugin-workspace-browser.git"
  },
  "bugs": {
    "url": "https://github.com/hestudio-community/dsh-plugin-workspace-browser/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.3 <0.2.3-0"
  },
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./icon-180": "./assets/icon-180.png"
  },
  "files": [
    "src/host",
    "src/shared",
    "dist/client.js",
    "dist/client.js.LEGAL.txt",
    "runner/Dockerfile",
    "runner/.dockerignore",
    "runner/automation.mjs",
    "runner/clipboard.mjs",
    "runner/identity.mjs",
    "runner/network-isolation.mjs",
    "runner/profile-recovery.mjs",
    "runner/protocol.mjs",
    "runner/proxy.mjs",
    "runner/runner.mjs",
    "runner/window-title.mjs",
    "runner/chromium.sh",
    "runner/openbox.xml",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "docs"
  ],
  "scripts": {
    "build": "esbuild src/client/entry.js --bundle --platform=browser --format=iife --target=es2022 --legal-comments=linked --outfile=dist/client.js",
    "build:runner": "node scripts/runner-release.mjs build",
    "prepack": "node scripts/runner-release.mjs verify",
    "test": "node --test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@novnc/novnc": "1.5.0",
    "esbuild": "0.25.12"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
