{
  "name": "@local/dsh-workspace-browser",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "An isolated workspace Chromium sidebar for DeepSeek Harness Web and Desktop.",
  "engines": { "node": ">=22", "dsh": "0.2.2-rc.3" },
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["src/host", "src/shared", "dist", "cordis.patch.yml", "locale/*.json", "icon.svg", "docs"],
  "scripts": {
    "build": "esbuild src/client/entry.js --bundle --platform=browser --format=iife --target=es2022 --legal-comments=linked --outfile=dist/client.js",
    "build:runner": "docker build --platform linux/amd64 --tag dsh-workspace-browser-runner:0.1.2 runner",
    "bundle:runner": "node scripts/runner-release.mjs bundle dsh-workspace-browser-runner:0.1.2",
    "prepack": "node scripts/runner-release.mjs verify",
    "test": "node --test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@novnc/novnc": "1.5.0",
    "esbuild": "0.25.12"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-connection"]
    }
  }
}
